extends ../../layouts/default.pug

block main 
  if (product.title)
    h1(class="mb-4") #{product.title}

  if (product.price)
    div(class="mb-4") Giá: <b> #{product.price}$ <b>

  if (product.discountPercentage)
    div(class="mb-4") Giảm giá: <b> #{product.discountPercentage}% <b>
  
  if (product.stock)
    div(class="mb-4") Số lượng hàng: <b> #{product.stock} <b>

  if (product.thumbnail)
    img(
      src=product.thumbnail,
      alt=product.title,
      width= 450 px
    )
  
  if (product.status)
    div(class="mb-4")
      span  Trạng thái:
      if (product.status == "active")
        span(class="badge badge-success") Đang hoạt động
      else
        span(class="badge badge-danger") Dừng hoạt động

  if (product.position)
    div(class="mb-4") Vị trí: <b> #{product.position} <b>

  if (product.description)
    div(class="mb-4") Mô tả:
    p !{product.description}

  a(
    href=`${prefixAdmin}/products/edit/${product.id}`
    class="btn btn-warning"
  ) Chỉnh sửa

  script(src="/admin/js/product.js")