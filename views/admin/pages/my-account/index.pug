extends ../../layouts/default.pug
include ../../mixins/alert.pug

block main
  +alert-error(3000)
  +alert-success(3000)

  h1(class="mb-4") #{pageTitle}

  if (user.avatar)
    img(
      src=`${user.avatar}`
      width="500px"
      class="mb-4"
      alt="Avatar"
    )
  
  if (user.fullName)
    p Họ tên: <b> #{user.fullName} </b>

  if (user.email)
    p Email: <b> #{user.email} </b>

  if (user.phone)
    p Số điện thoại: <b> #{user.phone} </b>
  
  if (user.status)
    p Trạng thái: <b> #{user.status === 'active' ? 'Hoạt động' : 'Ngừng hoạt động'} </b>

  if (role.title)
    p Phân quyền: <b> #{role.title} </b>

  a(
    href=`${prefixAdmin}/my-account/edit`
    class="btn btn-primary btn-sm"
  ) Sửa thông tin

