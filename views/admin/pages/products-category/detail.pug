extends ../../layouts/default.pug

block main 
  if (productCategory.title)
    h1(class="mb-4") #{productCategory.title}

  div(class="mb-4")
    if (parentCategory)
      b Danh mục cha: #{parentCategory.title}
    else
      b Đây là danh mục gốc

  if (productCategory.thumbnail)
    img(
      src=productCategory.thumbnail,
      alt=productCategory.title,
      width= 450 px
    )
  
  if (productCategory.status)
    div(class="mb-4")
      span  Trạng thái:
      if (productCategory.status == "active")
        span(class="badge badge-success") Đang hoạt động
      else
        span(class="badge badge-danger") Dừng hoạt động

  if (productCategory.position)
    div(class="mb-4") Vị trí: <b> #{productCategory.position} <b>

  if (productCategory.description)
    div(class="mb-4") Mô tả:
    p !{productCategory.description}

  a(
    href=`${prefixAdmin}/products-category/edit/${productCategory.id}`
    class="btn btn-warning"
  ) Chỉnh sửa

  script(src="/admin/js/product.js")