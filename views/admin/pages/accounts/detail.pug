extends ../../layouts/default.pug

block main 
  if (account.fullName)
    h1(class="mb-4") #{account.fullName}

  if (account.role_id.title)
    div(class="mb-4") Nhóm: <b> #{account.role_id.title} <b>

  if (account.avatar)
    img(
      src=account.avatar,
      alt=account.fullName,
      width= 450 px
    )

  if (account.email)
    div(class="mb-4") <b>Email: #{account.email} <b>

  if (account.phone)
    div(class="mb-4") Số điện thoại: <b> #{account.phone} <b>
  
  if (account.status)
    div(class="mb-4")
      span  Trạng thái:
      if (account.status == "active")
        span(class="badge badge-success") Đang hoạt động
      else
        span(class="badge badge-danger") Dừng hoạt động

  

  a(
    href=`${prefixAdmin}/accounts/edit/${account.id}`
    class="btn btn-warning"
  ) Chỉnh sửa

  script(src="/admin/js/product.js")