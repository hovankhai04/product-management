extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main 
  .container.my-3
    .row 
      .col-12
        +box-head(pageTitle)

    .chat
      .inner-body
        .inner-incoming
          .inner-name Em yêu
          .inner-content
            | A ơi sang nhà e nha, nhà e không có ai ở nhà

        .inner-outgoing
          .inner-content
            | Thế à? Oke em yêu

        .inner-incoming
          .inner-name Em yêu
          .inner-content
            | Nhanh nha

        .inner-outgoing
          .inner-content
            | Ck đến rồi mà thấy ai ở nhà đâu?

        .inner-incoming
          .inner-name Em yêu
          .inner-content
            | Thì em bảo không ai ở nhà mà :))

      .inner-foot
        form.inner-form(action="")
          input(
            type="text"
            name="content"
            placeholder="Nhập nội dung..."
          )
          button(type="submit")
            i.fa-solid.fa-paper-plane
              
              

