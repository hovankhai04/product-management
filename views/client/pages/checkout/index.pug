extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/alert.pug

block main
  +alert-success(3000)
  +alert-error(3000)

  .container.my-3
    .row 
      .col-12
        +box-head(pageTitle)
    if (cartDetail.products.length > 0)
      .row
        .col-12
          
            table(class="table table-bordered")
              thead
                tr
                  th STT
                  th Ảnh
                  th Tên
                  th Giá
                  th Số lượng
                  th Tổng tiền
              tbody
                
                  each item, index in cartDetail.products
                    tr
                      td #{index + 1}
                      td
                        img(src=item.productInfo.thumbnail alt=item.productInfo.title width="100")
                      td
                        p #{item.productInfo.title}
                      td #{item.productInfo.priceNew}$
                      td 
                        p #{item.quantity}
                      td #{item.totalPrice}$
                
            h3(class="text-right") Tổng đơn hàng: #{cartDetail.totalPrice}$
            .card.p-4.my-4
              form(
                action="/checkout/order"
                method="POST"
                class="mt-3"
              )
                div(class="form-group")
                  label(for="fullName") Họ và tên
                  input(
                    type="text"
                    name="fullName"
                    class="form-control"
                    id="fullName"
                    required
                  )

                div(class="form-group")
                  label(for="phone") Số điện thoại
                  input(
                    type="text"
                    name="phone"
                    class="form-control"
                    id="phone"
                    required
                  )

                div(class="form-group")
                  label(for="address") Địa chỉ
                  input(
                    type="text"
                    name="address"
                    class="form-control"
                    id="address"
                    required
                  )

                div(class="text-center mt-3")
                  button(
                    type="submit"
                    class="btn btn-primary btn-block"
                  ) Đặt hàng
    else
            p Không có sản phẩm trong giỏ hàng