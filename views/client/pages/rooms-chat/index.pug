extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main 
  .container.my-3 
    .row
      .col-12
        +box-head(pageTitle)

    .row.mb-3
      .col-12
        a(
          href="/rooms-chat/create"
          class="btn btn-primary btn-sm"
        ) Tạo phòng chat
    
    .row  
      each roomChat in roomChats
        .col-6 
          div(class="box-room")
            div(class="inner-avatar")
              img(
                src="/images/profile.png"
                alt=roomChat.title
              )
            
            div(class="inner-info")
              div(class="inner-name") #{roomChat.title}
              div(class="inner-buttons")
                a(
                  href=`/chat/${roomChat.id}`
                  class="btn btn-primary btn-sm"
                ) Nhắn tin

